{
  "openapi": "3.1.0",
  "info": {
    "title": "MarketPlace API",
    "description": "Auto-reports marketplace: buyers, inspectors, admins",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/admin/reports/{id}/revise": {
      "post": {
        "tags": [
          "moderation-controller"
        ],
        "operationId": "revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviseReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/admin/reports/{id}/delete": {
      "post": {
        "tags": [
          "moderation-controller"
        ],
        "operationId": "deleteReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/admin/reports/{id}/approve": {
      "post": {
        "tags": [
          "moderation-controller"
        ],
        "operationId": "approveReport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/admin/payouts/{id}/pay": {
      "post": {
        "tags": [
          "payout-controller"
        ],
        "operationId": "markAsPaid",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/admin/inspectors/{id}/verify": {
      "post": {
        "tags": [
          "admin-inspector-controller"
        ],
        "operationId": "verify",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorDto"
                }
              }
            }
          }
        }
      }
    },
    "/admin/inspectors/{id}/ban": {
      "post": {
        "tags": [
          "admin-inspector-controller"
        ],
        "operationId": "ban",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BanInspectorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InspectorDto"
                }
              }
            }
          }
        }
      }
    },
    "/admin/auth/setup-totp": {
      "post": {
        "tags": [
          "admin-auth-controller"
        ],
        "operationId": "setupTotp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSetupTotpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTotpSetupResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/admin/auth/login": {
      "post": {
        "tags": [
          "admin-auth-controller"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAuthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/admin/reports/{id}": {
      "get": {
        "tags": [
          "moderation-controller"
        ],
        "operationId": "getReportDetail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminReportDetailDto"
                }
              }
            }
          }
        }
      }
    },
    "/admin/reports/queue": {
      "get": {
        "tags": [
          "moderation-controller"
        ],
        "operationId": "getModerationQueue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModerationQueueItemDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/payouts": {
      "get": {
        "tags": [
          "payout-controller"
        ],
        "operationId": "listBatches",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PayoutBatch"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/inspectors": {
      "get": {
        "tags": [
          "admin-inspector-controller"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InspectorDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/": {
      "get": {
        "tags": [
          "admin-controller"
        ],
        "operationId": "getAdmin",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReviseReportRequest": {
        "type": "object",
        "properties": {
          "reasonText": {
            "type": "string"
          }
        },
        "required": [
          "reasonText"
        ]
      },
      "DeleteReportRequest": {
        "type": "object",
        "properties": {
          "reasonText": {
            "type": "string"
          }
        },
        "required": [
          "reasonText"
        ]
      },
      "InspectorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "telegramUserId": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "fullName",
          "id",
          "phone",
          "status",
          "telegramUserId"
        ]
      },
      "BanInspectorRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "AdminSetupTotpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminTotpSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "otpAuthUrl": {
            "type": "string"
          }
        },
        "required": [
          "otpAuthUrl",
          "secret"
        ]
      },
      "AdminLoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totpCode": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "totpCode"
        ]
      },
      "AdminAuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "AdminReportDetailDto": {
        "type": "object",
        "properties": {
          "report": {
            "$ref": "#/components/schemas/ReportDto"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModerationHistroyEntryDto"
            }
          }
        },
        "required": [
          "history",
          "report"
        ]
      },
      "ModerationHistroyEntryDto": {
        "type": "object",
        "properties": {
          "adminId": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "action",
          "adminId",
          "createdAt"
        ]
      },
      "PaintMeasurementDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "panelCode": {
            "type": "string"
          },
          "spot": {
            "type": "string"
          },
          "thicknessUm": {
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "panelCode",
          "spot",
          "thicknessUm"
        ]
      },
      "ReportDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "carId": {
            "type": "string",
            "format": "uuid"
          },
          "inspectorId": {
            "type": "string",
            "format": "uuid"
          },
          "versionNo": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "priceByn": {
            "type": "integer",
            "format": "int64"
          },
          "conclusionText": {
            "type": "string"
          },
          "stopFactors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSectionDto"
            }
          },
          "paintMeasurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaintMeasurementDto"
            }
          },
          "globalMedia": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMediaDto"
            }
          }
        },
        "required": [
          "carId",
          "globalMedia",
          "id",
          "inspectorId",
          "paintMeasurements",
          "sections",
          "status",
          "stopFactors",
          "versionNo"
        ]
      },
      "ReportMediaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "orderNo": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "kind",
          "orderNo",
          "s3Key",
          "status"
        ]
      },
      "ReportSectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sectionKey": {
            "type": "string"
          },
          "orderNo": {
            "type": "integer",
            "format": "int32"
          },
          "summary": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionItemDto"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMediaDto"
            }
          }
        },
        "required": [
          "id",
          "items",
          "media",
          "orderNo",
          "sectionKey",
          "summary"
        ]
      },
      "SectionItemDto": {
        "type": "object",
        "properties": {
          "itemKey": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "WARN",
              "BAD"
            ]
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "itemKey",
          "status"
        ]
      },
      "ModerationQueueItemDto": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "carId": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "inspectorId": {
            "type": "string",
            "format": "uuid"
          },
          "versionNo": {
            "type": "integer",
            "format": "int32"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "carId",
          "inspectorId",
          "make",
          "model",
          "reportId",
          "submittedAt",
          "versionNo",
          "vin"
        ]
      },
      "PayoutBatch": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "inspectorId": {
            "type": "string",
            "format": "uuid"
          },
          "inspectorName": {
            "type": "string"
          },
          "inspectorEmail": {
            "type": "string"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          },
          "amountByn": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "amountByn",
          "createdAt",
          "inspectorEmail",
          "inspectorId",
          "inspectorName",
          "periodEnd",
          "periodStart",
          "status",
          "uuid"
        ]
      },
      "AdminDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "id"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "TelegramData": {
        "type": "apiKey",
        "name": "X-Telegram-Data",
        "in": "header"
      }
    }
  }
}