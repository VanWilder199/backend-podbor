{
  "openapi": "3.1.0",
  "info": {
    "title": "MarketPlace API",
    "description": "Auto-reports marketplace: buyers, inspectors, admins",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/purchases": {
      "get": {
        "tags": [
          "purchase-controller"
        ],
        "operationId": "getPurchases",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PurchaseDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "purchase-controller"
        ],
        "operationId": "createPurchase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiatePurchaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InitiatePurchaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cars/{cardId}": {
      "post": {
        "tags": [
          "car-controller"
        ],
        "operationId": "createReport",
        "parameters": [
          {
            "name": "cardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReportRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "refreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/otp/verify": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "verifyOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/otp/send": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "operationId": "sendOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendOtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": []
      }
    },
    "/reports/view": {
      "get": {
        "tags": [
          "report-access-controller"
        ],
        "operationId": "view",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReportViewDto"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/cars/search": {
      "get": {
        "tags": [
          "car-controller"
        ],
        "operationId": "getCarByVin",
        "parameters": [
          {
            "name": "vin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CarDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InitiatePurchaseRequest": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "reportId"
        ]
      },
      "InitiatePurchaseResponse": {
        "type": "object",
        "properties": {
          "purchaseId": {
            "type": "string",
            "format": "uuid"
          },
          "redirectUrl": {
            "type": "string"
          }
        },
        "required": [
          "purchaseId",
          "redirectUrl"
        ]
      },
      "CreateReportRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ]
      },
      "VerifyOtpRequest": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "SMS",
              "EMAIL"
            ]
          },
          "otp": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6
          }
        },
        "required": [
          "channel",
          "destination",
          "otp"
        ]
      },
      "SendOtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^\\+375\\d{9}$"
          }
        }
      },
      "PaintMeasurementDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "panelCode": {
            "type": "string"
          },
          "spot": {
            "type": "string"
          },
          "thicknessUm": {
            "type": "integer",
            "format": "int32"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "panelCode",
          "spot",
          "thicknessUm"
        ]
      },
      "ReportMediaViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "orderNo": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "kind",
          "orderNo",
          "status"
        ]
      },
      "ReportSectionViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sectionKey": {
            "type": "string"
          },
          "orderNo": {
            "type": "integer",
            "format": "int32"
          },
          "summary": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionItemDto"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMediaViewDto"
            }
          }
        },
        "required": [
          "id",
          "items",
          "media",
          "orderNo",
          "sectionKey",
          "summary"
        ]
      },
      "ReportViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "carId": {
            "type": "string",
            "format": "uuid"
          },
          "priceByn": {
            "type": "integer",
            "format": "int64"
          },
          "conclusionText": {
            "type": "string"
          },
          "stopFactors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportSectionViewDto"
            }
          },
          "paintMeasurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaintMeasurementDto"
            }
          },
          "globalMedia": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportMediaViewDto"
            }
          }
        },
        "required": [
          "carId",
          "globalMedia",
          "id",
          "paintMeasurements",
          "sections",
          "stopFactors"
        ]
      },
      "SectionItemDto": {
        "type": "object",
        "properties": {
          "itemKey": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "WARN",
              "BAD"
            ]
          },
          "comment": {
            "type": "string"
          }
        },
        "required": [
          "itemKey",
          "status"
        ]
      },
      "PurchaseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "amountByn": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "amountByn",
          "createdAt",
          "id",
          "reportId",
          "status"
        ]
      },
      "CarDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "vin": {
            "type": "string"
          },
          "avbyListingUrl": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "listingStatus": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "make",
          "model",
          "vin"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "TelegramData": {
        "type": "apiKey",
        "name": "X-Telegram-Data",
        "in": "header"
      }
    }
  }
}